<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyTitle>千私云</AssemblyTitle>
    <Product>千私云</Product>
    <RootNamespace>LoalNas.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../../tools/filebrowser/filebrowser" Link="tools/filebrowser/filebrowser">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../tools/filebrowser/LICENSE" Link="tools/filebrowser/LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools/screen-capture/screen_worker.py" Link="tools/screen-capture/screen_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools/monitor/camera_worker.py" Link="tools/monitor/camera_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../tools/opencode/plugins/loalnas-approval.ts" Link="tools/opencode/plugins/loalnas-approval.ts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>

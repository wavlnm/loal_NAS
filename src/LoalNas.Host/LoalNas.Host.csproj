<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\qiansiyun.ico</ApplicationIcon>
    <AssemblyTitle>千私云</AssemblyTitle>
    <Product>千私云</Product>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\tools\filebrowser\filebrowser.exe" Link="tools/filebrowser/filebrowser.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\tools\filebrowser\LICENSE" Link="tools/filebrowser/LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\scripts\Enable-LoalNasFirewallRule.ps1" Link="scripts/Enable-LoalNasFirewallRule.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LoalNas": {
    "Host": {
      "Url": "http://[::]:5034",
      "PublicBaseUrl": "http://101.200.13.82:5034"
    },
    "Firewall": {
      "AutoConfigureOnStartup": true,
      "Tool": "auto",
      "EnsureTimeoutSeconds": 30
    },
    "Trash": {
      "RetentionDays": 30,
      "CleanupIntervalHours": 1
    },
    "Share": {
      "DefaultExpiryHours": 24,
      "MaxExpiryDays": 30,
      "MaxDownloadsPerShare": 1000,
      "MaxActiveShares": 500,
      "CleanupIntervalMinutes": 5,
      "CookieLifetimeMinutes": 120,
      "PasswordMaxLength": 64
    },
    "RemoteTerminal": {
      "Enabled": true,
      "DurationMinutes": 0
    },
    "ScreenCapture": {
      "MaxWidth": 1920,
      "MinWidth": 640,
      "DefaultWidth": 1280,
      "DefaultQuality": 60,
      "Framerate": 10,
      "MaxFrameAgeSeconds": 5,
      "IdleSeconds": 60,
      "WorkerScript": "tools/screen-capture/screen_worker.py",
      "OutputDirectory": ""
    },
    "Monitor": {
      "Enabled": true,
      "CameraDevice": "/dev/video0",
      "WorkerScript": "tools/monitor/camera_worker.py",
      "MinWidth": 320,
      "MaxWidth": 1280,
      "DefaultWidth": 640,
      "DefaultQuality": 60,
      "PreviewFps": 8,
      "IdleSeconds": 60,
      "MaxFrameAgeSeconds": 5,
      "DetectEnabled": false,
      "Sensitivity": "mid",
      "RingFps": 10,
      "ClipWidth": 1280,
      "ClipHeight": 720,
      "DetectFps": 3,
      "ConfirmHits": 3,
      "RecordSeconds": 10,
      "CooldownSeconds": 30,
      "ClipCrf": 23,
      "ClipWithAudio": true,
      "ClipFolderName": "监控录像",
      "ListenEnabled": true,
      "ListenBitrateKbps": 48,
      "ListenSampleRate": 16000,
      "ListenTicketTtlSeconds": 300,
      "ListenMaxSeconds": 300
    },
    "FileBrowser": {
      "Address": "127.0.0.1",
      "Port": 38080,
      "RelativeExecutablePath": "tools/filebrowser/filebrowser",
      "RuntimeDirectoryName": "/mnt/HDD-Data/loal-nas",
      "RootFolderName": "file",
      "DatabaseFileName": "filebrowser.db",
      "StartupTimeoutSeconds": 15
    }
  }
}

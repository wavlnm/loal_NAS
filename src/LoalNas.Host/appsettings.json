{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LoalNas": {
    "Host": {
      "Url": "http://[::]:5034",
      "PublicBaseUrl": "http://101.200.13.82:5034"
    },
    "Firewall": {
      "AutoConfigureOnStartup": true,
      "Tool": "auto",
      "EnsureTimeoutSeconds": 30
    },
    "Trash": {
      "RetentionDays": 30,
      "CleanupIntervalHours": 1
    },
    "RemoteTerminal": {
      "Enabled": true,
      "DurationMinutes": 0
    },
    "ScreenCapture": {
      "MaxWidth": 1920,
      "MinWidth": 640,
      "DefaultWidth": 1280,
      "DefaultQuality": 60,
      "Framerate": 10,
      "MaxFrameAgeSeconds": 5,
      "IdleSeconds": 60,
      "WorkerScript": "tools/screen-capture/screen_worker.py",
      "OutputDirectory": ""
    },
    "FileBrowser": {
      "Address": "127.0.0.1",
      "Port": 38080,
      "RelativeExecutablePath": "tools/filebrowser/filebrowser",
      "RuntimeDirectoryName": "/mnt/HDD-Data/loal-nas",
      "RootFolderName": "file",
      "DatabaseFileName": "filebrowser.db",
      "StartupTimeoutSeconds": 15
    }
  }
}

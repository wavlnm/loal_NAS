{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LoalNas": {
    "Host": {
      "Url": "http://[::]:5034",
      "PublicBaseUrl": "http://101.200.13.82:5034"
    },
    "Firewall": {
      "AutoConfigureOnStartup": true,
      "Tool": "auto",
      "EnsureTimeoutSeconds": 30
    },
    "Trash": {
      "RetentionDays": 30,
      "CleanupIntervalHours": 1
    },
    "Share": {
      "DefaultExpiryHours": 24,
      "MaxExpiryDays": 30,
      "MaxDownloadsPerShare": 1000,
      "MaxActiveShares": 500,
      "CleanupIntervalMinutes": 5,
      "CookieLifetimeMinutes": 120,
      "PasswordMaxLength": 64
    },
    "Archive": {
      "DefaultLevel": "normal",
      "Concurrency": 2,
      "MaxQueuedJobs": 20,
      "JobRetentionMinutes": 60,
      "TimeoutMinutes": 60,
      "MaxSourceBytes": 53687091200,
      "DiskHeadroomBytes": 104857600
    },
    "RemoteTerminal": {
      "Enabled": true,
      "DurationMinutes": 0
    },
    "ScreenCapture": {
      "MaxWidth": 1920,
      "MinWidth": 640,
      "DefaultWidth": 1280,
      "DefaultQuality": 60,
      "Framerate": 10,
      "MaxFrameAgeSeconds": 5,
      "IdleSeconds": 60,
      "WorkerScript": "tools/screen-capture/screen_worker.py",
      "OutputDirectory": ""
    },
    "Monitor": {
      "Enabled": true,
      "CameraDevice": "/dev/video0",
      "WorkerScript": "tools/monitor/camera_worker.py",
      "MinWidth": 320,
      "MaxWidth": 1280,
      "DefaultWidth": 640,
      "DefaultQuality": 60,
      "PreviewFps": 8,
      "IdleSeconds": 60,
      "MaxFrameAgeSeconds": 5,
      "DetectEnabled": false,
      "Sensitivity": "mid",
      "RingFps": 10,
      "ClipWidth": 1280,
      "ClipHeight": 720,
      "DetectFps": 3,
      "ConfirmHits": 3,
      "RecordSeconds": 10,
      "CooldownSeconds": 30,
      "ClipCrf": 23,
      "ClipWithAudio": true,
      "ClipFolderName": "监控录像",
      "ListenEnabled": true,
      "ListenBitrateKbps": 48,
      "ListenSampleRate": 16000,
      "ListenTicketTtlSeconds": 300,
      "ListenMaxSeconds": 300
    },
    "FileBrowser": {
      "Address": "127.0.0.1",
      "Port": 38080,
      "RelativeExecutablePath": "tools/filebrowser/filebrowser",
      "RuntimeDirectoryName": "/mnt/HDD-Data/loal-nas",
      "RootFolderName": "file",
      "DatabaseFileName": "filebrowser.db",
      "StartupTimeoutSeconds": 15
    },
    "Agent": {
      "Enabled": true,
      "BinaryPath": "tools/opencode/bin/opencode",
      "HomeDirectory": "",
      "Workspace": "/mnt/HDD-Data/loal-nas/file/AI工作区",
      "SharedRoot": "/mnt/HDD-Data/loal-nas/file",
      "ServePort": 4097,
      "ServeStartupTimeoutSeconds": 60,
      "ApprovalTimeoutSeconds": 120,
      "MaxConcurrentRuns": 1,
      "MaxPromptChars": 8000,
      "SessionListLimit": 30,
      "MessageListLimit": 200,
      "DefaultProvider": "deepseek",
      "DefaultModel": "deepseek-flash",
      "Providers": [
        {
          "Id": "deepseek",
          "Display": "DeepSeek",
          "BaseUrl": "https://api.deepseek.com",
          "Models": [
            "deepseek-flash",
            "deepseek-v4-pro"
          ]
        },
        {
          "Id": "qwen",
          "Display": "通义千问",
          "BaseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
          "Models": [
            "qwen-plus",
            "qwen3-coder-plus"
          ]
        },
        {
          "Id": "glm",
          "Display": "智谱 GLM",
          "BaseUrl": "https://open.bigmodel.cn/api/paas/v4",
          "Models": [
            "glm-4.6",
            "glm-4.5-air"
          ]
        },
        {
          "Id": "custom",
          "Display": "自定义",
          "BaseUrl": "",
          "Models": []
        }
      ],
      "SensitivePatterns": [
        "\\brm\\s+(?:-[a-zA-Z]*r[a-zA-Z]*f|-[a-zA-Z]*f[a-zA-Z]*r|-[a-zA-Z]*r\\s+-[a-zA-Z]*f|-[a-zA-Z]*f\\s+-[a-zA-Z]*r|--recursive\\s+--force|--force\\s+--recursive)",
        "\\b(sudo|su)\\b",
        "\\b(curl|wget|nc|ncat|netcat|ssh|scp|sftp|rsync|telnet|ftp)\\b",
        "\\b(dd|mkfs(\\.\\w+)?|shutdown|reboot|poweroff|halt)\\b",
        "(device-secret|model-config\\.json|\\.local/share/loal-nas)"
      ]
    }
  }
}